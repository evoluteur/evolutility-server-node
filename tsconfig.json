{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true
  },
  "include": [
    "config.ts",
    "app.ts",
    "bin/**/*.ts",
    "scripts/**/*.ts",
    "test/fixtures/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
